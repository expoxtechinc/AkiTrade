# Railway control-plane service — set values in Railway’s sealed variables UI, never in this file.
NODE_ENV=production
DATABASE_URL=
JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_OAUTH_PORTAL_URL=

# Optional separate worker service. It is intentionally non-executing in this release.
AKITRADE_AUTOMATION_WORKER_ENABLED=false
AKITRADE_WORKER_HEARTBEAT_SECONDS=60

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/privacy", "destination": "/api/index" },
    { "source": "/terms", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 30 },
    "api/[...path].ts": { "maxDuration": 30 }
  }
}
